# Server Configuration
PORT=3005
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5174

# Database Configuration
# Optional: Set DATABASE_URL to connect to external PostgreSQL (e.g. postgresql://user:pass@localhost:5432/library)
# If omitted or empty, the application uses persistent embedded PostgreSQL (PGlite) stored in ./data/postgres
DATABASE_URL=
DATABASE_DIR=./data/postgres

# Security & Authentication
JWT_SECRET=demo-secret-change-in-production-must-be-at-least-32-chars
COOKIE_SECRET=development-only-replace-with-a-random-secret
TOKEN_EXPIRY=8h

# Timezone (Fixed to Indian Standard Time)
APP_TIMEZONE=Asia/Kolkata

# Initial Staff Admin Seed Credentials (Development Demo)
DEMO_ADMIN_NAME="Library Staff Admin"
DEMO_ADMIN_EMAIL=admin@library.delhi
DEMO_ADMIN_PASSWORD=LibraryDemo2026!

# Production: use unique JWT_SECRET and COOKIE_SECRET (32+ characters), an HTTPS
# FRONTEND_ORIGIN, and DATABASE_URL when deploying to Vercel. Demo seeding is off.
# Set these once to bootstrap the first real administrator on an empty database.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME="Library Administrator"
BOOTSTRAP_ADMIN_PASSWORD=

# Email Service Configuration (Optional)
# Leave SMTP_HOST empty to use development logging mode (emails logged to terminal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Library <noreply@library.delhi>"
