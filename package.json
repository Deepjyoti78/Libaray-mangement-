    "db:seed": "node server/db/seed.js",
    "seed": "node server/db/seed.js",
    "test": "node --test-concurrency=1 --test tests/booking.test.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
