  "scripts": {
    "start": "concurrently -n \"server,client\" -c \"blue,green\" \"node server/index.js\" \"vite\"",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"node server/index.js\" \"vite\"",
    "client": "vite",
    "server": "node server/index.js",
    "db:migrate": "node server/db/migrate.js",
